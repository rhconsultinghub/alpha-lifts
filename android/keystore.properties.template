# Copy to android/keystore.properties (gitignored) and fill in after generating the UPLOAD
# keystore. Generate once, then BACK IT UP alongside the passwords — with Play App Signing
# enabled Google holds the real app signing key and this is only the upload key (replaceable
# via a support ticket, but don't rely on that).
#
#   keytool -genkeypair -v -keystore alpha-lifts-upload.keystore -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the android/ directory.
storeFile=alpha-lifts-upload.keystore
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
